      "keys": [
        {
          "dr": 0,
          "dc": 0,
          "key": {
            "type": "button",
            "label": "◀ MAG",
            "read": {
              "input": "ENGINE_MAGNETO_1"
            },
            "press": {
              "step": -1,
              "min": 0
            }
          }
        },
        {
          "dr": 0,
          "dc": 1,
          "key": {
            "type": "readout",
            "label": "MAGS",
            "read": {
              "input": "ENGINE_MAGNETO_1"
            },
            "text": {
              "0": "OFF",
              "1": "R",
              "2": "L",
              "3": "BOTH",
              "4": "START"
            },
            "valueIcons": {
              "0": "magneto_off",
              "1": "magneto_right",
              "2": "magneto_left",
              "3": "magneto_both",
              "4": "magneto_start"
            }
          }
        },
        {
          "dr": 0,
          "dc": 2,
          "key": {
            "type": "button",
            "label": "MAG ▶",
            "read": {
              "input": "ENGINE_MAGNETO_1"
            },
            "press": {
              "step": 1,
              "max": 3
            }
          }
        },
        {
          "dr": 0,
          "dc": 3,
          "key": {
            "type": "switch",
            "label": "START",
            "read": {
              "input": "ENGINE_MAGNETO_1"
            },
            "states": {
              "4": "on"
            },
            "otherwise": "off",
            "press": {
              "hold": 4,
              "release": 3,
              "repeatMs": 250
            }
          }
        }
      ]
    },
