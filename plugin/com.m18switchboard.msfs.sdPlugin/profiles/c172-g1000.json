{
  "id": "c172-g1000",
  "name": "Cessna 172 SP G1000 (Asobo, MSFS 2024)",
  "notes": "Controls and values: docs/aircraft/c172-controls.md. Standby battery modelled as ARM/OFF only (TEST not modelled).",
  "match": {
    "path": ["asobo_c172sp_g1000", "c172sp-as1000"]
  },
  "pages": [
    {
      "name": "Main",
      "keys": {
        "0": { "type": "switch", "label": "STBY\nBATT", "read": { "input": "ELECTRICAL_BATTERY_STBY_2" },
               "states": { "0": "on", "1": "off", "2": "on" }, "text": { "0": "ARM", "1": "OFF", "2": "TEST" },
               "press": { "cycle": [1, 0] } },
        "1": { "type": "switch", "label": "ALT", "icon": "master_alternator", "read": { "input": "ELECTRICAL_ALTERNATOR_1" },
               "states": { "0": "off", "1": "on" }, "press": { "cycle": [0, 1] } },
        "2": { "type": "switch", "label": "BAT", "icon": "master_battery", "read": { "input": "ELECTRICAL_BATTERY_1" },
               "states": { "0": "off", "1": "on" }, "press": { "cycle": [0, 1] } },
        "3": { "type": "switch", "label": "AVN\nBUS 1", "read": { "input": "ELECTRICAL_LINE_BUS_1_TO_AVIONICS_BUS_1" },
               "states": { "0": "off", "1": "on" }, "press": { "cycle": [0, 1] } },
        "4": { "type": "switch", "label": "AVN\nBUS 2", "read": { "input": "ELECTRICAL_LINE_BUS_2_TO_AVIONICS_BUS_2" },
               "states": { "0": "off", "1": "on" }, "press": { "cycle": [0, 1] } },

        "5": { "type": "switch", "label": "BCN", "icon": "lights_beacon", "read": { "input": "LIGHTING_BEACON_1" },
               "states": { "0": "off", "1": "on" }, "press": { "cycle": [0, 1] } },
        "6": { "type": "switch", "label": "LAND", "icon": "lights_landing_lights", "read": { "input": "LIGHTING_LANDING_1" },
               "states": { "0": "off", "1": "on" }, "press": { "cycle": [0, 1] } },
        "7": { "type": "switch", "label": "TAXI", "icon": "lights_taxi_lights", "read": { "input": "LIGHTING_TAXI_1" },
               "states": { "0": "off", "1": "on" }, "press": { "cycle": [0, 1] } },
        "8": { "type": "switch", "label": "NAV", "icon": "lights_nav_lights", "read": { "input": "LIGHTING_NAV_0" },
               "states": { "0": "off", "1": "on" }, "press": { "cycle": [0, 1] } },
        "9": { "type": "switch", "label": "STRB", "icon": "lights_strobes", "read": { "input": "LIGHTING_STROBE_0" },
               "states": { "0": "off", "1": "on" }, "press": { "cycle": [0, 1] } },

        "10": { "type": "switch", "label": "FUEL\nPUMP", "icon": "toggle_fuel_pump", "read": { "input": "FUEL_PUMP_1" },
                "states": { "0": "off", "1": "on" }, "press": { "cycle": [0, 1] } },
        "11": { "type": "button", "label": "◀ MAG", "read": { "input": "ENGINE_MAGNETO_1" },
                "press": { "step": -1, "min": 0 } },
        "12": { "type": "readout", "label": "MAGS", "read": { "input": "ENGINE_MAGNETO_1" },
                "text": { "0": "OFF", "1": "R", "2": "L", "3": "BOTH", "4": "START" } },
        "13": { "type": "button", "label": "MAG ▶", "read": { "input": "ENGINE_MAGNETO_1" },
                "press": { "step": 1, "max": 3 } },
        "14": { "type": "switch", "label": "START", "read": { "input": "ENGINE_MAGNETO_1" },
                "states": { "4": "on" }, "otherwise": "off",
                "press": { "hold": 4, "release": 3 } }
      }
    },
    {
      "name": "Auxiliary",
      "keys": {
        "0": { "type": "readout", "label": "COM1", "read": { "var": "COM ACTIVE FREQUENCY:1", "unit": "MHz" }, "decimals": 3 },
        "1": { "type": "readout", "label": "COM1 STBY", "read": { "var": "COM STANDBY FREQUENCY:1", "unit": "MHz" }, "decimals": 3 },
        "2": { "type": "button", "label": "COM1\nSWAP", "press": { "event": "COM_STBY_RADIO_SWAP" } },
        "3": { "type": "readout", "label": "QNH", "read": { "var": "KOHLSMAN SETTING MB:1", "unit": "millibars" }, "decimals": 0 },
        "4": { "type": "readout", "label": "XPDR", "read": { "var": "TRANSPONDER CODE:1", "unit": "number" }, "pad": 4 },

        "5": { "type": "switch", "label": "PITOT\nHEAT", "icon": "pitot_heat", "read": { "input": "DEICE_PITOT_1" },
               "states": { "0": "off", "1": "on" }, "press": { "cycle": [0, 1] } },
        "6": { "type": "button", "label": "◀ FUEL", "read": { "input": "FUEL_SELECTOR_1" },
               "press": { "step": -1, "min": 0 } },
        "7": { "type": "readout", "label": "FUEL SEL", "read": { "input": "FUEL_SELECTOR_1" },
               "text": { "0": "LEFT", "1": "BOTH", "2": "RIGHT" } },
        "8": { "type": "button", "label": "FUEL ▶", "read": { "input": "FUEL_SELECTOR_1" },
               "press": { "step": 1, "max": 2 } }
      }
    }
  ]
}
